# Copie para .env (local) ou cadastre em Vercel → Settings → Environment Variables.
ANTHROPIC_API_KEY=

# Opcionais
# ASK_MODEL=claude-opus-5-5        # ou claude-haiku-5-5 (bem mais barato)
# ASK_IP_LIMIT=15                  # perguntas por IP por hora
# ASK_DAILY_LIMIT=300              # perguntas por dia no total
# UPSTASH_REDIS_REST_URL=          # limites compartilhados entre instâncias
# UPSTASH_REDIS_REST_TOKEN=
